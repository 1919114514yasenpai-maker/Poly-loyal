rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net: Default-deny all undefined paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Entity Validation: UserProfile
    function isValidUserProfile(data, uid) {
      return data.userId == uid &&
        isValidId(data.userId) &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 30 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 100000)) &&
        data.totalWins is number && data.totalWins >= 0 &&
        data.totalKills is number && data.totalKills >= 0 &&
        data.totalMatches is number && data.totalMatches >= 0 &&
        (!('favoriteClass' in data) || (data.favoriteClass is string && data.favoriteClass.size() <= 30)) &&
        (!('totalDeaths' in data) || (data.totalDeaths is number && data.totalDeaths >= 0)) &&
        (!('rating' in data) || data.rating == null || data.rating is number) &&
        (!('rankPoints' in data) || data.rankPoints == null || data.rankPoints is number) &&
        (!('soloRankPoints' in data) || data.soloRankPoints == null || data.soloRankPoints is number) &&
        (!('duoRankPoints' in data) || data.duoRankPoints == null || data.duoRankPoints is number) &&
        (!('trioRankPoints' in data) || data.trioRankPoints == null || data.trioRankPoints is number) &&
        (!('soloWins' in data) || data.soloWins == null || data.soloWins is number) &&
        (!('duoWins' in data) || data.duoWins == null || data.duoWins is number) &&
        (!('trioWins' in data) || data.trioWins == null || data.trioWins is number) &&
        (!('coins' in data) || data.coins == null || data.coins is number) &&
        (!('equippedSkin' in data) || (data.equippedSkin is string && data.equippedSkin.size() <= 50)) &&
        (!('equippedTitle' in data) || (data.equippedTitle is string && data.equippedTitle.size() <= 50)) &&
        (!('equippedBadge' in data) || (data.equippedBadge is string && data.equippedBadge.size() <= 50)) &&
        (!('equippedEmote' in data) || (data.equippedEmote is string && data.equippedEmote.size() <= 50)) &&
        data.createdAt is string && data.createdAt.size() <= 50 &&
        data.updatedAt is string && data.updatedAt.size() <= 50 &&
        data.keys().hasAll(['userId', 'displayName', 'totalWins', 'totalKills', 'totalMatches', 'createdAt', 'updatedAt']) &&
        data.keys().size() <= 30;
    }

    // Entity Validation: LeaderboardEntry
    function isValidLeaderboardEntry(data, uid) {
      return data.userId == uid &&
        isValidId(data.userId) &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 30 &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 100000)) &&
        data.totalWins is number && data.totalWins >= 0 &&
        data.totalKills is number && data.totalKills >= 0 &&
        data.updatedAt is string && data.updatedAt.size() <= 50 &&
        (!('rating' in data) || data.rating == null || data.rating is number) &&
        (!('solorating' in data) || data.solorating == null || data.solorating is number) &&
        (!('duorating' in data) || data.duorating == null || data.duorating is number) &&
        (!('triorating' in data) || data.triorating == null || data.triorating is number) &&
        data.keys().hasAll(['userId', 'displayName', 'totalWins', 'totalKills', 'updatedAt']) &&
        data.keys().size() <= 16;
    }

    // 1. User Profiles Collection
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn(); // Allow authenticated users to search/query player profiles for friend adding

      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasAny(['displayName', 'email', 'photoURL', 'totalWins', 'totalKills', 'totalDeaths', 'totalMatches', 'favoriteClass', 'rating', 'rankPoints', 'soloRankPoints', 'duoRankPoints', 'trioRankPoints', 'soloWins', 'duoWins', 'trioWins', 'coins', 'equippedSkin', 'equippedTitle', 'equippedBadge', 'equippedEmote', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // 1b. Friends Subcollection
    match /users/{userId}/friends/{friendId} {
      allow read, write: if isSignedIn();
    }

    // 1c. Friend Requests Subcollection
    match /users/{userId}/friendRequests/{requestId} {
      allow read, write: if isSignedIn();
    }

    
    // Entity Validation: MatchHistory
    function isValidMatchHistory(data, uid, historyId) {
      return data.id == historyId &&
        data.userId == uid &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        data.mode is string && data.mode.size() <= 30 &&
        data.placement is number &&
        data.kills is number &&
        (!('score' in data) || data.score is number) &&
        data.ratingChange is number &&
        data.newRating is number &&
        data.createdAt is string && data.createdAt.size() <= 50 &&
        data.keys().hasAll(['id', 'userId', 'mode', 'placement', 'kills', 'ratingChange', 'newRating', 'createdAt']) &&
        data.keys().size() <= 9;
    }

    // 3. User Match History Subcollection
    match /users/{userId}/history/{historyId} {
      allow get, list: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidId(historyId) &&
        isValidMatchHistory(incoming(), userId, historyId);
      allow update, delete: if false; // Match history is immutable once created
    }

    // 2. Global Leaderboard Collection (Public read, Owner-only write)
    match /leaderboard/{userId} {
      allow read: if true; // Public leaderboard ranking

      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidLeaderboardEntry(incoming(), userId);

      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        isValidLeaderboardEntry(incoming(), userId) &&
        incoming().userId == existing().userId;

      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // 4. Game Reviews and Feedback Collection
    match /reviews/{reviewId} {
      allow read: if true; // Public review list
      allow create: if true; // Allow players to submit reviews
      // Only official developer 1919114514yasenpai@gmail.com can reply/update reviews
      allow update, delete: if isSignedIn() && request.auth.token.email.toLowerCase() == '1919114514yasenpai@gmail.com';
    }

    // Test connection endpoint
    match /test/{docId} {
      allow read: if true;
    }
  }
}
