rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net: Default-deny all undefined paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Entity Validation: UserProfile
    function isValidUserProfile(data, uid) {
      return data.userId == uid &&
        isValidId(data.userId) &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 30 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        data.totalWins is number && data.totalWins >= 0 &&
        data.totalKills is number && data.totalKills >= 0 &&
        data.totalMatches is number && data.totalMatches >= 0 &&
        (!('favoriteClass' in data) || (data.favoriteClass is string && data.favoriteClass.size() <= 30)) &&
        (!('totalDeaths' in data) || (data.totalDeaths is number && data.totalDeaths >= 0)) &&
        (!('rating' in data) || data.rating is number) &&
        (!('rankPoints' in data) || data.rankPoints is number) &&
        data.createdAt is string && data.createdAt.size() <= 50 &&
        data.updatedAt is string && data.updatedAt.size() <= 50 &&
        data.keys().hasAll(['userId', 'displayName', 'totalWins', 'totalKills', 'totalMatches', 'createdAt', 'updatedAt']) &&
        data.keys().size() <= 13;
    }

    // Entity Validation: LeaderboardEntry
    function isValidLeaderboardEntry(data, uid) {
      return data.userId == uid &&
        isValidId(data.userId) &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 30 &&
        data.totalWins is number && data.totalWins >= 0 &&
        data.totalKills is number && data.totalKills >= 0 &&
        data.updatedAt is string && data.updatedAt.size() <= 50 &&
        (!('rating' in data) || data.rating is number) &&
        data.keys().hasAll(['userId', 'displayName', 'totalWins', 'totalKills', 'updatedAt']) &&
        data.keys().size() <= 6;
    }

    // 1. User Profiles Collection
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Disallow bulk scraping of user profiles

      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasAny(['displayName', 'email', 'photoURL', 'totalWins', 'totalKills', 'totalDeaths', 'totalMatches', 'favoriteClass', 'rating', 'rankPoints', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);
    }

    
    // Entity Validation: MatchHistory
    function isValidMatchHistory(data, uid, historyId) {
      return data.id == historyId &&
        data.userId == uid &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        data.mode is string && data.mode.size() <= 30 &&
        data.placement is number &&
        data.kills is number &&
        data.ratingChange is number &&
        data.newRating is number &&
        data.createdAt is string && data.createdAt.size() <= 50 &&
        data.keys().hasAll(['id', 'userId', 'mode', 'placement', 'kills', 'ratingChange', 'newRating', 'createdAt']) &&
        data.keys().size() == 8;
    }

    // 3. User Match History Subcollection
    match /users/{userId}/history/{historyId} {
      allow get, list: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidId(historyId) &&
        isValidMatchHistory(incoming(), userId, historyId);
      allow update, delete: if false; // Match history is immutable once created
    }

    // 2. Global Leaderboard Collection (Public read, Owner-only write)
    match /leaderboard/{userId} {
      allow read: if true; // Public leaderboard ranking

      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidLeaderboardEntry(incoming(), userId);

      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        isValidLeaderboardEntry(incoming(), userId) &&
        incoming().userId == existing().userId;

      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // Test connection endpoint
    match /test/{docId} {
      allow read: if true;
    }
  }
}
